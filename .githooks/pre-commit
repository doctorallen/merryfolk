#!/bin/sh
# Stamps js/version.js with the build number, the day of the year and how
# many builds have been made that day (this one included), as in v285.3, and
# today's date, so every commit carries its own version and the game shows it
# in the corner. Days are the local calendar's.
d=$(date +%Y-%m-%d)
doy=$((10#$(date +%j)))
n=$(( $(git log --date=format-local:%Y-%m-%d --format=%cd 2>/dev/null | grep -c "^$d\$") + 1 ))
cat > js/version.js <<EOV
'use strict';
// The build stamp shown in the corner. Written by .githooks/pre-commit on
// every commit: v<day of the year>.<build that day> and the date.
const BUILD_INFO = 'v$doy.$n · $d';
EOV
git add js/version.js
